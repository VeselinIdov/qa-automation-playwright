{
    "name": "qa-automation-playwright",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test tests/ui",
        "test:api": "playwright test tests/api",
        "test:headed": "playwright test --headed",
        "report": "allure generate allure-results --clean -o allure-report",
        "triage": "node .azure/scripts/triage-failures.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@faker-js/faker": "^10.5.0",
        "dotenv": "^17.4.2",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.116.0",
        "@playwright/test": "^1.62.0",
        "@types/node": "^24.10.13",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "allure-commandline": "^2.43.0",
        "allure-playwright": "^3.10.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.11.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3"
    }
}
