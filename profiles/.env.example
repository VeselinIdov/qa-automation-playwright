# Template for profiles/.env.<TEST_ENV>. Copy to profiles/.env.dev and fill in
# real values — that file is gitignored and must never be committed.

# Base URL for the setup and ui projects. Navigation expects saucedemo paths
# such as /inventory.html, so this is the saucedemo origin.
UI_URL=

# Base URL for the api project. PostsEndpoint appends `posts`, so this is the
# origin (plus any /api prefix) and nothing more.
API_URL=

# saucedemo credentials, read by tests/auth.setup.ts
USER_NAME=
PASSWORD=

# Bearer token sent by BaseRequest, read by tests/api/posts-api.test.ts
SECRET_KEY=
